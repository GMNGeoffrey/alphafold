# General Docker exclusions
.dockerignore
.git*
docker/
**/Dockerfile
**/*.Dockerfile

# Some project-specific exclusions we don't really need in the docker image
docs/
imgs/
notebooks/

# The rest of this file mirrors .gitignore but with adjustments for
# dockerignore's slightly different syntax

# Users are asked to download this file separately, probably because it's GPL
# licensed and they don't want to deal with distribution.
alphafold/common/stereo_chemical_props.txt
output

